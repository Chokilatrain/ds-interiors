{
  "name": "ds-interiors-site",
  "private": true,
  "version": "0.1.0",
  "description": "DS Interiors portfolio: React + TypeScript on Vite, pre-rendered to static HTML with vite-react-ssg.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run fetch:cms && vite-react-ssg build",
    "fetch:cms": "node scripts/fetch-cms.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vite-react-ssg": "^0.9.2"
  }
}
