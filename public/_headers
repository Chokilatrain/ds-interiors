# Cloudflare Pages headers. Hashed build assets and fonts never change, so cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Images keep their names when swapped for originals, so cache them for a day.
/images/*
  Cache-Control: public, max-age=86400
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
