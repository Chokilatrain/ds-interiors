# Where page content comes from at build time.
#   fake  The seed files in src/content/seed (default). Use this to show the site before the CMS exists.
#   cms   src/content/cms/generated.json, written by scripts/fetch-cms.mjs. Falls back to fake if missing.
VITE_CONTENT_SOURCE=fake

# 1 = shows the small "Preview" tag in the corner. Turn off for the real launch.
VITE_PREVIEW=1

# 1 = every page gets noindex,nofollow and robots.txt disallows all. Keep on until launch.
VITE_NOINDEX=1

# The live address, used for canonical links and the sitemap. Change once the domain is chosen.
VITE_SITE_URL=https://dsinteriors.example

# Contact form endpoint. Empty = the form runs in fake mode and sends nothing.
VITE_FORMS_ENDPOINT=

# CMS base URL, read by scripts/fetch-cms.mjs in cms mode (not wired yet).
CMS_URL=
